{
  "expo": {
    "name": "Woolly Ram Pranks",
    "slug": "woolly-ram-pranks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Woolly Ram Pranks to open your photos so you can pick a profile photo.",
          "cameraPermission": "Allow Woolly Ram Pranks to use your camera so you can take a profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
